# Pooled connection (Neon Dashboard → Connect → pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection, for drizzle-kit migrations (same host without -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional overrides for the scraper
SCRAPER_USER_AGENT=""
SCRAPER_DELAY_MS=""

# Claude API, for titles and warranty text the rules cannot settle (optional:
# without it normalize runs rules only)
ANTHROPIC_API_KEY=""

# Site. Phase 4 sets these on Vercel; locally they can stay empty.
NEXT_PUBLIC_SITE_URL=""
REVALIDATE_SECRET=""
NEXT_PUBLIC_GA_ID=""
